{
  // The to-do app: its own Worker on this same repo, behind Cloudflare Access.
  //
  // Two settings are not optional, and both were learned by getting them wrong:
  //   assets.run_worker_first — without it Cloudflare serves a matching static file
  //     BEFORE the Worker runs, so the auth check protects /api/* and every HTML
  //     page stays open to the internet.
  //   workers_dev: false — an Access policy attaches to a hostname. A workers.dev
  //     subdomain is not covered by the policy on your domain, so leaving it on
  //     publishes the app with no authentication at all.
  //
  // Secrets are never written here. Set them once:
  //   wrangler secret put GITHUB_TOKEN --config apps/todos/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "todos",
  "main": "worker.js",
  "compatibility_date": "2026-07-24",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    // The sources this app may edit. One entry per PROJECT, not per repository:
    // a repo holding three projects gets three entries, and projects spread over
    // several repos still appear in one app. This list IS the security boundary —
    // the browser sends an `id` and the Worker resolves it here, so a path that is
    // not listed cannot be named at all.
    //
    // `label` is what the owner sees, so name the project, never the plumbing.
    // Omit it and one is derived from the path. Omit `id` and one is derived too;
    // set it explicitly if you want short, stable ids in URLs.
    "TODO_SOURCES": [
      {
        "id": "brochure",
        "label": "Brochure",
        "repo": "owner/repo",
        "path": "projects/brochure/next-steps.md"
      },
      {
        "id": "site",
        "label": "Site",
        "repo": "owner/other-repo",
        "path": "projects/site/next-steps.md"
      }
    ],

    // Short form for a single repo, if that is all you have. Ignored when
    // TODO_SOURCES is set.
    "GITHUB_REPO": "owner/repo",
    "TODO_BRANCH": "main"
  }
}
