node_modules/
dist/
.astro/
.DS_Store
.env
.env.*

# Pages the owner doesn't want published (a private draft, a page for one client).
# Never committed means never deployed, since Cloudflare builds from the repo.
# See "a page the owner doesn't want published" in source/formats/website.md.
site/src/pages/internal/

# The team module's folder is local-only by design: it holds people data
# (1:1 digests, assessments) that must never leave this machine.
# Only its README (the structure guide) is committed.
team/*
!team/README.md
