{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git pull)",
      "Bash(git pull:*)",
      "Bash(npm install)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run preview:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/{{ROUTER}}/.claude/hooks/own-changes.mjs\" --baseline"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/{{ROUTER}}/.claude/hooks/workspace-start.sh\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PROJECT_DIR=\"$CLAUDE_PROJECT_DIR/{{ROUTER}}\" node \"$CLAUDE_PROJECT_DIR/{{ROUTER}}/.claude/hooks/send-guard.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/{{ROUTER}}/.claude/hooks/session-end.mjs\""
          },
          {
            "type": "command",
            "command": "CLAUDE_PROJECT_DIR=\"$CLAUDE_PROJECT_DIR/{{ROUTER}}\" node \"$CLAUDE_PROJECT_DIR/{{ROUTER}}/.claude/hooks/turn-check.mjs\""
          }
        ]
      }
    ]
  }
}
