---
// Projects: the signed and nearly-signed customers, and the work outstanding on them.
//
// The capacity timeline that opened this page moved to the dashboard, under the pipeline chart:
// load is a question you ask before opening a customer, not after. What replaced it is the work
// itself, in a rail beside the accounts, filterable by project and by priority.
import Base from "../layouts/Base.astro";
import EntityCard from "../components/EntityCard.astro";
import Badge from "../components/ui/Badge.astro";
import Monogram from "../components/ui/Monogram.astro";
import OwnerTags from "../components/OwnerTags.astro";
import { accounts, projects, nextSteps, value, sizeOf, STAGE, stageLabel } from "../lib/content.mjs";
import { model, tabLabel } from "../../config.mjs";
import { t, formatNumber } from "../lib/i18n.mjs";

const all = accounts();
const live = all.filter((c) => c.status === "active" || c.status === "scoping");
const projs = projects();

const byStage = (a, b) => STAGE.indexOf(a.stage) - STAGE.indexOf(b.stage);
const blocks = live
  .map((c) => ({ company: c, mine: projs.filter((p) => p.company === c.slug).sort(byStage) }))
  .sort((a, b) => b.mine.length - a.mine.length);

const PRIORITY = ["high", "normal", "low"];
const steps = nextSteps().sort(
  (a, b) => PRIORITY.indexOf(a.priority ?? "normal") - PRIORITY.indexOf(b.priority ?? "normal")
);
const stepProjects = [...new Set(steps.map((s) => s.projectSlug))].map((slug) => ({
  slug,
  name: projs.find((p) => p.slug === slug)?.name ?? slug,
  n: steps.filter((s) => s.projectSlug === slug).length,
}));
const priorities = PRIORITY.map((key) => ({ key, n: steps.filter((s) => (s.priority ?? "normal") === key).length }))
  .filter((x) => x.n);
---
<Base title={tabLabel("/customers")} lead={t("proj.lead")}>
  <div class="proj-layout">
    <div class="proj-main">
      {blocks.map(({ company: c, mine }) => (
        <section class="cust">
          <header class="cust-head">
            <a class="cust-thumb" href={`/customers/${c.slug}`}>
              {c.image ? <img src={c.image} alt="" loading="lazy" /> : <Monogram name={c.name} />}
            </a>
            <div class="cust-ident">
              <h2 class="display cust-name"><a href={`/customers/${c.slug}`}>{c.name}</a></h2>
              <p class="muted cust-industry">{value(c.industry) ?? t("common.unknown")}</p>
              <div class="cust-tags">
                <Badge status={c.status} />
                {value(c.owner) && <Badge plain label={`${t("common.owner")}: ${c.owner}`} />}
                {sizeOf(c) && (
                  <Badge plain label={`${formatNumber(sizeOf(c))} ${model.sizeUnit}`} />
                )}
                {c.parent?.name && <Badge plain label={`${t("common.within")} ${c.parent.name}`} />}
              </div>
            </div>
          </header>

          {mine.length === 0 ? (
            <p class="faint" style="font-size:13.5px;">{t("cust.noProject")}</p>
          ) : (
            <div class="grid-cards grid-cards-tight">
              {mine.map((p) => (
                <EntityCard
                  item={p}
                  href={`/customers/${c.slug}/${p.slug}`}
                  subtitle={`${stageLabel(p.stage)} · ${value(p.owner) ?? "—"}`}
                  meta={[stageLabel(p.stage), ...(p.tags ?? []).slice(0, 2)]}
                />
              ))}
            </div>
          )}
        </section>
      ))}
    </div>

    <aside class="steps-rail" data-steps>
      <h2 class="label">{t("proj.steps")}</h2>
      <p class="faint steps-note">{t("proj.stepsNote")}</p>

      <div class="steps-filters">
        <div class="steps-filter-row">
          <span class="steps-filter-label">{t("proj.filterPriority")}</span>
          <div class="steps-chips">
            <button class="schip is-on" type="button" data-filter="priority" data-value="">{t("pros.all")}</button>
            {priorities.map((x) => (
              <button class="schip" type="button" data-filter="priority" data-value={x.key}
                      style={`--chip: var(--priority-${x.key})`}>
                <span class="schip-dot"></span>{t(`priority.${x.key}`)}<span class="schip-n">{x.n}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="steps-filter-row">
          <span class="steps-filter-label">{t("proj.filterProject")}</span>
          <div class="steps-chips">
            <button class="schip is-on" type="button" data-filter="project" data-value="">{t("pros.all")}</button>
            {stepProjects.map((x) => (
              <button class="schip" type="button" data-filter="project" data-value={x.slug}>
                {x.name}<span class="schip-n">{x.n}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <ol class="steps-list" data-steps-list>
        {steps.map((s) => (
          <li class="srow" data-priority={s.priority ?? "normal"} data-project={s.projectSlug}>
            <span class="srow-bar" style={`background: var(--priority-${s.priority ?? "normal"})`}></span>
            <span class="srow-text">{s.text}</span>
            <span class="srow-meta">
              <OwnerTags owner={s.owner} />
              {s.waiting_on && <span class="srow-wait">{t("common.waitingOn")} {s.waiting_on}</span>}
            </span>
            <a class="srow-project" href={s.href}>{s.project}</a>
          </li>
        ))}
      </ol>
      <p class="faint steps-empty" data-steps-empty hidden>{t("pros.empty")}</p>
    </aside>
  </div>

  <style is:global>
    .proj-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: var(--space-12);
      align-items: start;
    }
    .proj-main { min-width: 0; display: grid; gap: var(--space-16); }

    .cust-head {
      display: grid;
      grid-template-columns: 88px 1fr;
      gap: var(--space-4);
      align-items: center;
      margin-bottom: var(--space-5, var(--space-4));
    }
    .cust-thumb {
      position: relative;
      aspect-ratio: 1;
      border-radius: var(--radius-card);
      overflow: hidden;
      border: 1px solid var(--hairline);
      background: var(--surface-sunken);
    }
    .cust-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .cust-thumb .monogram { font-size: 28px; }
    /* min-width:0 lets the column shrink; overflow-wrap lets the text inside it actually break.
       Both are needed: a company name written as one 20-character word has no break opportunity,
       so the column shrinks and the word still sticks out. */
    .cust-ident { display: grid; gap: 5px; min-width: 0; overflow-wrap: anywhere; }
    .cust-name { font-size: 25px; }
    .cust-name a { color: var(--ink); }
    .cust-industry { font-size: 13.5px; margin: 0; }
    .cust-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 2px; }
    .grid-cards-tight { grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); }

    /* The work rail ------------------------------------------------------- */
    .steps-rail { position: sticky; top: 80px; display: grid; gap: var(--space-2); min-width: 0; }
    .steps-note { font-size: 11.5px; margin-bottom: var(--space-2); }

    .steps-filters { display: grid; gap: 6px; margin-bottom: var(--space-3); }
    .steps-filter-row { display: grid; gap: 4px; }
    .steps-filter-label {
      font-size: 10px; font-weight: 600; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--ink-faint);
    }
    .steps-chips { display: flex; gap: 4px; flex-wrap: wrap; }
    .schip {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 3px 8px;
      border-radius: var(--radius-chip);
      border: 1px solid var(--hairline);
      background: var(--surface);
      font: inherit; font-size: 11px; font-weight: 500;
      color: var(--ink-muted); cursor: pointer;
      max-width: 100%;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .schip:hover { color: var(--ink); border-color: var(--ink-faint); }
    .schip.is-on {
      color: var(--ink);
      border-color: color-mix(in srgb, var(--chip, var(--ink)) 45%, transparent);
      background: color-mix(in srgb, var(--chip, var(--ink)) 10%, transparent);
    }
    .schip-dot { width: 7px; height: 7px; border-radius: 999px; background: var(--chip, var(--ink-faint)); flex: none; }
    .schip-n { color: var(--ink-faint); font-variant-numeric: tabular-nums; }

    .steps-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
    .srow {
      position: relative;
      display: grid;
      gap: 3px;
      padding: 9px 11px 9px 14px;
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--radius-chip);
      overflow: hidden;
    }
    .srow[hidden] { display: none; }
    .srow-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 3px; }
    .srow-text { font-size: 12.5px; line-height: 1.4; }
    .srow-meta { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
    .srow-wait { font-size: 10.5px; color: var(--ink-faint); }
    .srow-project { font-size: 10.5px; letter-spacing: 0.04em; color: var(--ink-faint); }
    .srow-project:hover { color: var(--accent); }
    .steps-empty { font-size: 12px; padding: var(--space-4) 0; }

    @media (max-width: 1080px) {
      .proj-layout { grid-template-columns: 1fr; }
      .steps-rail { position: static; padding-top: var(--space-8); border-top: 1px solid var(--hairline); }
    }
  </style>

  <script>
    const rail = document.querySelector("[data-steps]");
    const list = document.querySelector("[data-steps-list]");
    if (rail && list) {
      const rows = [...list.children];
      const empty = document.querySelector("[data-steps-empty]");
      const picked = { priority: "", project: "" };
      const apply = () => {
        let shown = 0;
        for (const r of rows) {
          const ok =
            (!picked.priority || r.dataset.priority === picked.priority) &&
            (!picked.project || r.dataset.project === picked.project);
          r.hidden = !ok;
          if (ok) shown++;
        }
        empty.hidden = shown > 0;
      };
      for (const b of rail.querySelectorAll("[data-filter]")) {
        b.addEventListener("click", () => {
          const { filter, value } = b.dataset;
          picked[filter] = picked[filter] === value ? "" : value;
          for (const sib of rail.querySelectorAll(`[data-filter="${filter}"]`)) {
            sib.classList.toggle("is-on", sib.dataset.value === picked[filter]);
          }
          apply();
        });
      }
      apply();
    }
  </script>
</Base>
