---
// Every dated milestone across every customer, on one axis, one lane per customer.
//
// This is a load and capacity view, not a history. What it is for is seeing that two workshops and
// a seminar land in the same fortnight before committing to a third.
//
// Dots are positioned by date on a shared scale, so overlaps are real overlaps. A milestone recorded
// as a month rather than a day sits on the first of that month and is drawn hollow, because placing
// it precisely would be inventing precision we do not have.
//
// The hover detail goes through the page-level tooltip, via data-tip-title and data-tip-rows. A tip
// drawn inside this component was clipped by its own scroller: every dot lost 37 to 53 pixels off
// the top, because overflow-x: auto computes overflow-y to auto too. See ui/HoverTip.astro.
import { TODAY, sectorOf, sectorColor } from "../lib/content.mjs";
import {t, formatDate, LOCALE} from "../lib/i18n.mjs";

const { milestones, companies, months = 3 } = Astro.props;

const ms = [...milestones].sort((a, b) => a.day.localeCompare(b.day));
const nameOf = Object.fromEntries(companies.map((c) => [c.slug, c.name]));
const colorOfCompany = Object.fromEntries(companies.map((c) => [c.slug, sectorColor(sectorOf(c))]));

// The window: everything recorded, but never opening more than `months` before today, because two
// years of empty track to reach this month is what makes a timeline useless.
//
// Named `at`, not `t`. Astro hoists imports to module scope and leaves the rest in the component
// function, so a `const t` here shadowed the `t` imported from i18n without failing to compile, and
// every t("tl.foot") below was parsing a translation key as a date. The legend rendered empty and
// the today marker's tooltip read "NaN".
const at = (d) => Date.parse(d + "T00:00:00Z");
const floor = new Date(Date.parse(TODAY + "T00:00:00Z"));
floor.setUTCMonth(floor.getUTCMonth() - months);
const start = Math.max(Math.min(...ms.map((m) => at(m.day))), floor.getTime());
const end = Math.max(...ms.map((m) => at(m.day)), Date.parse(TODAY + "T00:00:00Z"));
const span = Math.max(end - start, 86400000);
const pct = (d) => ((Math.min(Math.max(at(d), start), end) - start) / span) * 100;

const visible = ms.filter((m) => at(m.day) >= start);
const lanes = companies
  .map((c) => ({ company: c, items: visible.filter((m) => m.company === c.slug) }))
  .filter((l) => l.items.length)
  .sort((a, b) => a.items[0].day.localeCompare(b.items[0].day));

// Month ticks across the window.
const ticks = [];
const cursor = new Date(start);
cursor.setUTCDate(1);
while (cursor.getTime() <= end) {
  if (cursor.getTime() >= start) ticks.push(new Date(cursor));
  cursor.setUTCMonth(cursor.getUTCMonth() + 1);
}
const isPast = (d) => !(d > TODAY);
const monthLabel = (d) =>
  d.toLocaleDateString(LOCALE, { month: "short", timeZone: "UTC" });
const dayLabel = (d, vague) => formatDate(d, { month: "short", day: !vague });
---
<div class="tl-scroll" data-tl-scroll><div class="tl">
  <div class="tl-axis">
    <span class="tl-axis-pad"></span>
    <div class="tl-axis-track">
      {ticks.map((d) => (
        <span class="tl-tick" style={`left:${pct(d.toISOString().slice(0, 10))}%`}>
          {monthLabel(d)}
        </span>
      ))}
    </div>
  </div>

  {lanes.map(({ company, items }) => (
    <div class="tl-lane">
      <a class="tl-name" href={`/customers/${company.slug}`}>{company.name}</a>
      <div class="tl-track">
        <span class="tl-rule"></span>
        <span class="tl-today" style={`left:${pct(TODAY)}%`} title={`${t("tl.today")}, ${TODAY}`}></span>
        {items.map((m) => {
          const past = isPast(m.day);
          return (
            <a
              class={`tl-dot ${past ? "is-past" : "is-future"} ${m.vague ? "is-vague" : ""}`}
              href={m.href}
              style={`left:${pct(m.day)}%; --dot: ${colorOfCompany[company.slug]}`}
              aria-label={`${dayLabel(m.day, m.vague)}, ${company.name}: ${m.text}`}
              data-tip-title={dayLabel(m.day, m.vague)}
              data-tip-rows={JSON.stringify(
                [m.kind ? t(`kind.${m.kind}`) : null, m.text, past ? null : t("tl.ahead")].filter(Boolean)
              )}
            ></a>
          );
        })}
      </div>
    </div>
  ))}

  </div>
  <p class="faint tl-foot">{t("tl.foot")}</p>
</div>

<script>
  // A timeline wider than the screen opens on its left edge, which is the oldest milestone and the
  // one nobody came to look at. Centre it on today instead, and only when it actually overflows: at
  // desk width the whole window fits and moving it would be moving it away from everything.
  //
  // Once, on load. A person who has scrolled has said where they want to be, so a resize only
  // re-centres for someone who has not touched it.
  const scroller = document.querySelector("[data-tl-scroll]");
  const today = scroller?.querySelector(".tl-today");
  if (scroller && today) {
    let touched = false;
    const centre = () => {
      const overflow = scroller.scrollWidth - scroller.clientWidth;
      if (overflow <= 0) return;
      const view = scroller.clientWidth;
      // Where today sits inside the content, and then inside what is on screen right now.
      const x =
        today.getBoundingClientRect().left -
        scroller.getBoundingClientRect().left +
        scroller.scrollLeft;
      const onScreen = x - scroller.scrollLeft;
      // Already comfortably in view: leave it. At desk width the window overflows by a hair and
      // today is nowhere near an edge, so scrolling would only push the oldest milestone off for
      // nothing. Idempotent too: once centred, onScreen is half the viewport and this returns.
      const margin = Math.min(64, view * 0.15);
      if (onScreen >= margin && onScreen <= view - margin) return;
      scroller.scrollLeft = Math.max(0, Math.min(x - view / 2, overflow));
    };
    centre();
    for (const e of ["pointerdown", "wheel", "touchstart", "keydown"]) {
      scroller.addEventListener(e, () => { touched = true; }, { passive: true, once: true });
    }
    addEventListener("resize", () => { if (!touched) centre(); });
  }
</script>

<style is:global>
  /* Its own scroller. A six-lane chart at 375px is unreadable, so scrolling it beats squashing it.
     The hover detail is not in here any more, which is what stopped the scroller clipping it. */
  .tl-scroll { overflow-x: auto; }
  .tl { --tl-name: 150px; min-width: 560px; }

  .tl-axis, .tl-lane {
    display: grid;
    grid-template-columns: var(--tl-name) 1fr;
    gap: var(--space-4);
    align-items: center;
  }
  .tl-axis { padding-bottom: var(--space-2); }

  /* The name column is pinned to the left edge of the scroller. Scrolling the track used to carry
     the customer names off screen, which leaves six lanes of coloured dots and no way to tell whose
     they are. It mattered from the moment this opens centred on today rather than at the left.
     The panel is --surface, so the pinned cell has to be too or it reads as a stripe. */
  .tl-axis-pad, .tl-name {
    position: sticky;
    left: 0;
    z-index: 3;
    background: var(--surface);
  }
  /* The lane hover tint runs under the pinned cell, so it repaints it to match. */
  .tl-lane:hover .tl-name { background: var(--surface-sunken); }
  .tl-axis-track { position: relative; height: 14px; }
  .tl-tick {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .tl-lane { padding: 3px 0; }
  .tl-lane:hover { background: var(--surface-sunken); }
  .tl-name {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink);
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tl-track { position: relative; height: 26px; }
  .tl-rule {
    position: absolute;
    left: 0; right: 0; top: 50%;
    height: 1px;
    background: var(--hairline);
  }
  .tl-today {
    position: absolute;
    top: 0; bottom: 0;
    width: 0;
    border-left: 1px dashed var(--stage-3);
    opacity: 0.6;
  }

  .tl-dot {
    position: absolute;
    top: 50%;
    width: 18px; height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 999px;
    display: grid;
    place-items: center;
  }
  .tl-dot::before {
    content: "";
    width: 9px; height: 9px;
    border-radius: 999px;
    border: 2px solid var(--dot, var(--ink-muted));
    background: var(--dot, var(--ink-muted));
  }
  .tl-dot.is-future::before { background: var(--surface); }
  .tl-dot.is-vague::before { border-style: dotted; background: var(--surface); }
  .tl-dot:hover { z-index: 6; }
  .tl-dot:hover::before { transform: scale(1.25); }


  .tl-foot {
    font-size: 12px;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--hairline);
    max-width: var(--measure);
  }

  @media (max-width: 720px) {
    .tl { --tl-name: 96px; }
    .tl-name { font-size: 11px; }
  }
</style>
